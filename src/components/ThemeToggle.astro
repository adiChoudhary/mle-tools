---
/**
 * ThemeToggle — small client island that wraps the ThemeManager.
 * Provides a button that toggles dark/light theme and shows the
 * correct icon for the current mode.
 *
 * Enhanced with accessibility features:
 * - Proper ARIA labels that update with theme state
 * - Keyboard navigation support
 * - Focus management
 * - Screen reader announcements
 *
 * Usage: <ThemeToggle client:load />
 */
---

<div class="theme-toggle-container">
  <button
    id="theme-toggle"
    class="theme-toggle-btn relative p-2 text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-md transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-900"
    aria-label="Switch to dark theme"
    title="Toggle theme"
  >
    <!-- Sun icon (visible in dark mode) -->
    <svg class="w-5 h-5 hidden dark:block" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
      <path fill-rule="evenodd" d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 100 2h1z" clip-rule="evenodd" />
    </svg>
    <!-- Moon icon (visible in light mode) -->
    <svg class="w-5 h-5 dark:hidden" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
      <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
    </svg>
  </button>

  <!-- Screen reader live region for theme change announcements -->
  <div id="theme-status" class="sr-only" aria-live="polite" aria-atomic="true"></div>
</div>

<script>
  import { ThemeManager } from '../utils/theme-manager.ts';

  const manager = new ThemeManager();
  const btn = document.getElementById('theme-toggle');
  const statusEl = document.getElementById('theme-status');

  function updateButton() {
    if (!btn) return;

    const theme = manager.theme;
    const isDark = theme === 'dark';

    // Update ARIA label
    btn.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');

    // Update title
    btn.setAttribute('title', `Switch to ${isDark ? 'light' : 'dark'} theme`);
  }

  function announceThemeChange(theme: 'light' | 'dark') {
    if (statusEl) {
      statusEl.textContent = `Switched to ${theme} theme`;

      // Clear announcement after a delay
      setTimeout(() => {
        statusEl.textContent = '';
      }, 1000);
    }
  }

  // Initial button state
  updateButton();

  // Listen for theme changes from any source
  window.addEventListener('theme-change', (event) => {
    updateButton();
    announceThemeChange((event as CustomEvent).detail.theme);
  });

  // Handle button click
  btn?.addEventListener('click', () => {
    manager.toggle();
  });

  // Handle keyboard shortcuts (T key for theme toggle)
  document.addEventListener('keydown', (event) => {
    // Only activate if no modifier keys and not in an input
    if (event.key.toLowerCase() === 't' &&
        !event.metaKey && !event.ctrlKey && !event.altKey &&
        !(event.target instanceof HTMLInputElement) &&
        !(event.target instanceof HTMLTextAreaElement)) {

      event.preventDefault();
      manager.toggle();
      btn?.focus(); // Focus the button after keyboard shortcut
    }
  });
</script>
