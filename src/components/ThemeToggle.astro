---
/**
 * ThemeToggle — small client island that wraps the ThemeManager.
 * Provides a button that toggles dark/light theme and shows the
 * correct icon for the current mode.
 *
 * Accessibility:
 * - ARIA label updates with theme state
 * - Keyboard navigable, visible focus ring
 * - Screen reader live-region announcement on change
 *
 * Usage: <ThemeToggle />
 */
import { icon } from '../utils/icons.ts';
---

<div class="theme-toggle-container">
  <button
    id="theme-toggle"
    type="button"
    class="dt-btn dt-btn-ghost grid h-9 w-9 place-items-center p-0!"
    aria-label="Switch to light theme"
    title="Toggle theme"
  >
    <!-- Sun icon (visible in dark mode) -->
    <span class="hidden dark:block" aria-hidden="true" set:html={icon('sun', 17)}></span>
    <!-- Moon icon (visible in light mode) -->
    <span class="block dark:hidden" aria-hidden="true" set:html={icon('moon', 17)}></span>
  </button>

  <!-- Screen reader live region for theme change announcements -->
  <div id="theme-status" class="sr-only" aria-live="polite" aria-atomic="true"></div>
</div>

<script>
  import { ThemeManager } from '../utils/theme-manager.ts';

  const manager = new ThemeManager();
  const btn = document.getElementById('theme-toggle');
  const statusEl = document.getElementById('theme-status');

  function updateButton() {
    if (!btn) return;

    const theme = manager.theme;
    const isDark = theme === 'dark';

    // Update ARIA label
    btn.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');

    // Update title
    btn.setAttribute('title', `Switch to ${isDark ? 'light' : 'dark'} theme`);
  }

  function announceThemeChange(theme: 'light' | 'dark') {
    if (statusEl) {
      statusEl.textContent = `Switched to ${theme} theme`;

      // Clear announcement after a delay
      setTimeout(() => {
        statusEl.textContent = '';
      }, 1000);
    }
  }

  // Initial button state
  updateButton();

  // Listen for theme changes from any source
  window.addEventListener('theme-change', (event) => {
    updateButton();
    announceThemeChange((event as CustomEvent).detail.theme);
  });

  // Handle button click
  btn?.addEventListener('click', () => {
    manager.toggle();
  });
</script>
