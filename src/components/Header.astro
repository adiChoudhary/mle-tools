---
/**
 * Shared sticky site header — glassmorphism bar with logo,
 * command-palette trigger (⌘K) and theme toggle.
 *
 * The ⌘K button dispatches the global `toggle-command-palette` event
 * (handled by CommandPalette.astro in BaseLayout).
 */
import ThemeToggle from './ThemeToggle.astro';
import { icon } from '../utils/icons.ts';
---

<header class="dt-glass sticky top-0 z-40" role="banner">
  <div class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between px-4 sm:px-6 lg:px-8">
    <!-- Brand -->
    <a
      href="/"
      class="flex items-center gap-2.5 rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500/60 focus-visible:ring-offset-2"
      aria-label="DevToolbox home"
    >
      <span
        class="grid h-8 w-8 place-items-center rounded-[9px] bg-gradient-to-br from-violet-500 to-fuchsia-600 text-white shadow-[0_2px_10px_-2px_rgba(139,92,246,0.55)]"
        aria-hidden="true"
        set:html={icon('box', 16, 2)}
      ></span>
      <span class="text-[15px] font-semibold tracking-tight">DevToolbox</span>
    </a>

    <div class="flex items-center gap-1.5">
      <!-- Command Palette Trigger -->
      <span class="hidden sm:inline-flex">
        <button
          id="command-palette-btn"
          type="button"
          class="dt-btn dt-btn-ghost dt-btn-sm"
          aria-label="Open command palette"
        >
          <span aria-hidden="true" set:html={icon('search', 14)}></span>
          <span class="hidden md:inline">Search tools</span>
          <span class="dt-kbd">⌘K</span>
        </button>
      </span>

      <!-- Theme Toggle -->
      <ThemeToggle />
    </div>
  </div>
</header>

<script>
  document.getElementById('command-palette-btn')?.addEventListener('click', function () {
    window.dispatchEvent(new CustomEvent('toggle-command-palette'));
  });
</script>
