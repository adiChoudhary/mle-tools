---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { TOOLS as tools, TOOL_CATEGORIES } from '../utils/tools.ts';
import { icon } from '../utils/icons.ts';

const FEATURES = [
  { icon: 'lock', title: 'Private by design', body: 'Strict CSP, zero network calls — your data never leaves the tab.' },
  { icon: 'zap', title: 'Web-Worker fast', body: 'Inputs over 10 MB are processed off the main thread, so the UI never freezes.' },
  { icon: 'wifi-off', title: 'Works offline', body: 'A service worker caches the app; the tools load once and stay available.' },
  { icon: 'command', title: '⌘K everywhere', body: 'Instant tool search with full keyboard control — no mouse required.' },
];
---

<BaseLayout
  title="Privacy-First Developer Tools"
  description="A blazing-fast, SEO-optimized collection of developer utilities that process all data locally in your browser. JSON formatter, Base64 encoder, JWT decoder, and more."
  keywords="developer tools, JSON formatter, Base64 encoder, JWT decoder, privacy-first, client-side"
>
  <!-- Skip Navigation Link (WCAG 2.4.1 Bypass Blocks) -->
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:rounded-md focus:bg-violet-600 focus:px-4 focus:py-2 focus:text-white focus:outline-none"
  >
    Skip to main content
  </a>

  <div class="flex min-h-full flex-col">
    <Header />

    <!-- Hero -->
    <div class="relative overflow-hidden">
      <!-- Background: subtle grid + aurora glows -->
      <div class="dt-grid-bg absolute inset-0" aria-hidden="true"></div>
      <div class="dt-glow -top-32 left-1/2 h-80 w-[36rem] -translate-x-1/2 bg-violet-500/25 dark:bg-violet-600/20" aria-hidden="true"></div>
      <div class="dt-glow top-24 left-[8%] h-56 w-56 bg-fuchsia-500/10 dark:bg-fuchsia-600/10" aria-hidden="true"></div>
      <div class="dt-glow top-40 right-[6%] h-64 w-64 bg-indigo-500/10 dark:bg-indigo-600/10" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-4xl px-4 pb-16 pt-20 text-center sm:px-6 lg:pb-24 lg:pt-28">
        <div class="mb-7 flex justify-center">
          <span class="dt-badge dt-badge-accent">
            <span aria-hidden="true" set:html={icon('sparkles', 13)}></span>
            100% in your browser — nothing is ever uploaded
          </span>
        </div>

        <h1 class="text-4xl font-bold leading-[1.08] tracking-tight sm:text-6xl">
          Developer tools that
          <br class="hidden sm:block" />
          <span class="bg-gradient-to-r from-violet-500 via-violet-400 to-fuchsia-500 bg-clip-text text-transparent">
            never touch your data.
          </span>
        </h1>

        <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed dt-text-2 sm:text-lg">
          Format JSON, decode JWTs, hash, encode and convert — twelve fast utilities that run
          entirely client-side. No sign-up, no servers, no tracking.
        </p>

        <!-- Quick Search -->
        <div class="mx-auto mt-9 max-w-md">
          <button
            id="main-search-btn"
            type="button"
            class="dt-searchbox"
            aria-label="Search tools"
          >
            <span class="dt-text-3" aria-hidden="true" set:html={icon('search', 16)}></span>
            <span class="flex-1">Search tools…</span>
            <span class="dt-kbd">⌘K</span>
          </button>
        </div>

        <p class="mt-4 text-xs dt-text-3">12 tools · Free forever · Works offline</p>
      </div>
    </div>

    <!-- Tools Grid -->
    <main id="main-content" role="main" class="relative">
      <div class="mx-auto w-full max-w-6xl px-4 pb-20 sm:px-6 lg:px-8">
        {TOOL_CATEGORIES.map((cat) => {
          const catTools = tools.filter((t) => t.category === cat.id);
          return (
            <section class="mb-12 last:mb-0" aria-labelledby={`cat-${cat.id}`}>
              <div class="mb-4 flex items-center gap-4">
                <h2
                  id={`cat-${cat.id}`}
                  class="shrink-0 text-[12.5px] font-semibold uppercase tracking-[0.14em] dt-text-3"
                >
                  {cat.label}
                </h2>
                <div class="h-px flex-1 bg-(--border)" aria-hidden="true"></div>
              </div>

              <nav aria-label="Tool navigation">
                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                  {catTools.map((tool) => (
                    <a href={tool.path} class="dt-tool-card" aria-label={tool.name}>
                      <div class="flex items-start justify-between">
                        <span class="dt-icon-tile" aria-hidden="true" set:html={icon(tool.icon, 20)}></span>
                        <span class="dt-tool-arrow" aria-hidden="true" set:html={icon('arrow-right', 16)}></span>
                      </div>
                      <h3 class="mt-4 text-[15px] font-semibold tracking-tight">{tool.name}</h3>
                      <p class="mt-1 text-[13px] leading-relaxed dt-text-2">{tool.description}</p>
                    </a>
                  ))}
                </div>
              </nav>
            </section>
          );
        })}
      </div>

      <!-- Feature strip -->
      <section aria-label="Why DevToolbox" class="mx-auto w-full max-w-6xl px-4 pb-24 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {FEATURES.map((f) => (
            <div class="dt-card p-5">
              <span class="dt-icon-tile h-9! w-9! rounded-[10px]!" aria-hidden="true" set:html={icon(f.icon, 17)}></span>
              <h3 class="mt-3.5 text-[14.5px] font-semibold tracking-tight">{f.title}</h3>
              <p class="mt-1 text-[13px] leading-relaxed dt-text-2">{f.body}</p>
            </div>
          ))}
        </div>
      </section>
    </main>

    <Footer />
  </div>

  <!-- Search button handler -->
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      var btn = document.getElementById('main-search-btn');
      if (btn) {
        btn.addEventListener('click', function () {
          window.dispatchEvent(new CustomEvent('toggle-command-palette'));
        });
      }
    });
  </script>
</BaseLayout>
