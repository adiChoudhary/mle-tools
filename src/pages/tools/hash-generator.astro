---
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout
  title="Hash Generator - MD5, SHA-1, SHA-256, SHA-512"
  description="Generate MD5, SHA-1, SHA-256, and SHA-512 hashes for text with live real-time computation. All hashing happens locally in your browser using the Web Crypto API."
  toolName="Hash Generator"
  toolIcon="🔐"
  keywords="hash generator, MD5, SHA-1, SHA-256, SHA-512, checksum, cryptographic hash, developer tools"
>
  <div id="hash-generator-tool" data-tool="hash-generator"></div>

  <script>
    import { HashGenerator } from '../../components/tools/HashGenerator.js';
    import { ErrorBoundary } from "../../utils/error-boundary.ts";

    document.addEventListener('DOMContentLoaded', async () => {
      const element = document.getElementById('hash-generator-tool');
      if (element) {
        const generator = new HashGenerator(element);
        const boundary = new ErrorBoundary(element, async () => {
          generator.init();
          element._componentInstance = generator;
        });
        await boundary.run();
        boundary.attachGlobalHandler();
      }
    });

    window.addEventListener('beforeunload', () => {
      const element = document.getElementById('hash-generator-tool');
      if (element && element._componentInstance) element._componentInstance.destroy();
    });
  </script>
</ToolLayout>
