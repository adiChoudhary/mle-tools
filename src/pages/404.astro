---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TOOLS } from '../utils/tools.ts';
import { icon } from '../utils/icons.ts';

// Deduplicate: several tools share one page (regex-and-sample-data)
const uniqueTools = TOOLS.filter((t, i) => TOOLS.findIndex(x => x.path === t.path) === i);
---

<BaseLayout
  title="Page not found"
  description="The page you are looking for does not exist. Browse the DevToolbox developer tools instead."
  keywords="404, page not found, developer tools"
>
  <!-- Skip Navigation Link (WCAG 2.4.1 Bypass Blocks) -->
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:rounded-md focus:bg-violet-600 focus:px-4 focus:py-2 focus:text-white focus:outline-none"
  >
    Skip to main content
  </a>

  <main id="main-content" class="relative min-h-full" role="main">
    <!-- Background: subtle grid + glow -->
    <div class="dt-grid-bg absolute inset-0" aria-hidden="true"></div>
    <div class="dt-glow -top-24 left-1/2 h-64 w-[28rem] -translate-x-1/2 bg-violet-500/20 dark:bg-violet-600/15" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 lg:px-8">
      <p
        class="mb-4 bg-gradient-to-r from-violet-500 to-fuchsia-500 bg-clip-text text-6xl font-extrabold tracking-tight text-transparent"
        aria-hidden="true"
      >
        404
      </p>
      <h1 class="mb-4 text-3xl font-bold tracking-tight">Page not found</h1>
      <p class="mb-8 dt-text-2">
        The page you are looking for does not exist or has been moved.
        Head back to the home page or pick a tool below.
      </p>
      <a
        href="/"
        class="dt-btn dt-btn-primary mx-auto"
      >
        Back to home
        <span aria-hidden="true" set:html={icon('arrow-right', 15)}></span>
      </a>

      <h2 class="mb-4 mt-16 text-[12.5px] font-semibold uppercase tracking-[0.14em] dt-text-3">Available tools</h2>
      <nav aria-label="Tool navigation" class="grid grid-cols-1 gap-2.5 text-left sm:grid-cols-2">
        {uniqueTools.map((tool) => (
          <a
            href={tool.path}
            class="flex items-center gap-3 rounded-xl border border-(--border) bg-(--surface) px-4 py-3 transition-colors hover:border-(--border-strong) hover:bg-(--surface-2) focus:outline-none focus-visible:ring-2 focus-visible:ring-violet-500/60 focus-visible:ring-offset-2"
          >
            <span class="dt-icon-tile h-7! w-7! rounded-[8px]!" aria-hidden="true" set:html={icon(tool.icon, 15)}></span>
            <span class="text-sm font-medium">{tool.name}</span>
          </a>
        ))}
      </nav>
    </div>
  </main>
</BaseLayout>
