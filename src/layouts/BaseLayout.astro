---
import '../styles/global.css';
import CommandPalette from '../components/CommandPalette.astro';
import { TOOLS } from '../utils/tools.ts';

export interface Props {
  title: string;
  description: string;
  keywords?: string;
  ogImage?: string;
}

const {
  title,
  description,
  keywords = 'developer tools, JSON formatter, Base64 encoder, JWT decoder, privacy-first',
  ogImage = '/og-default.png'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Schema.org WebSite structured data (rendered via set:html — define:vars wraps an
// ld+json script in an executable IIFE and breaks the JSON output).
// No SearchAction: the site has no server-side search route (tool search is the
// client-side ⌘K command palette).
const siteData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "DevToolbox",
  url: Astro.site,
  description: "Privacy-first developer utilities that process all data locally in your browser."
};

// Shared tool list for the command palette (single source of truth: utils/tools.ts)
const tools = TOOLS;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <!-- Essential Meta -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- SEO Meta -->
    <title>{title} | DevToolbox</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DevToolbox" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | DevToolbox`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@devtoolbox" />
    <meta name="twitter:creator" content="@devtoolbox" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={`${title} | DevToolbox`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Preload critical resources (none — fully self-hosted, zero external requests) -->
    <meta name="generator" content={Astro.generator} />

    <!-- Content Security Policy is emitted automatically by Astro (security.csp
         in astro.config.mjs) with sha256 hashes for every bundled script/style.
         The theme bootstrap below is the only inline script; its hash is pinned
         in astro.config.mjs (security.csp.scriptDirective.hashes). -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('devtoolbox-theme');
          var dark = t ? t === 'dark' : true;
          if (dark) document.documentElement.classList.add('dark');
        } catch (e) {}
      })();
    </script>

    <!-- Schema.org Structured Data (WebSite) -->
    <script type="application/ld+json" set:html={JSON.stringify(siteData)}></script>
  </head>
  <body class="dt-shell h-full">
    <!-- Each page provides its own main-content landmark and skip link
         (ToolLayout / index / 404); this layout no longer wraps the slot
         in a second main element. -->
    <slot />

    <!-- Command Palette -->
    <CommandPalette tools={tools} />

    <!-- Service Worker Registration -->
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function (err) {
            console.debug('Service Worker registration failed:', err);
          });
        });
      }
    </script>
  </body>
</html>
