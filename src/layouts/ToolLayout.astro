---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { icon } from '../utils/icons.ts';

export interface Props {
  title: string;
  description: string;
  keywords?: string;
  toolName: string;
  toolIcon?: string;
  ogImage?: string;
}

const { title, description, keywords, toolName, toolIcon = 'box', ogImage = '/og-default.png' } = Astro.props;

// Schema.org WebApplication structured data (see BaseLayout note on set:html).
const toolData = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: title,
  description: description,
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  applicationCategory: "DeveloperApplication",
  operatingSystem: "Any",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  browserRequirements: "Requires JavaScript",
  featureList: keywords || "",
  author: { "@type": "Organization", name: "DevToolbox" }
};
---

<BaseLayout title={title} description={description} keywords={keywords} ogImage={ogImage}>
  <!-- Skip Navigation Link (WCAG 2.4.1 Bypass Blocks) -->
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[60] focus:rounded-md focus:bg-violet-600 focus:px-4 focus:py-2 focus:text-white focus:outline-none"
  >
    Skip to main content
  </a>

  <div class="flex min-h-full flex-col">
    <Header />

    <!-- Schema.org Structured Data (WebApplication) -->
    <script type="application/ld+json" set:html={JSON.stringify(toolData)}></script>

    <!-- Main Content -->
    <main id="main-content" class="mx-auto w-full max-w-6xl flex-1 px-4 py-10 sm:px-6 lg:px-8" role="main">
      <!-- Tool Header -->
      <div class="mb-8">
        <nav class="mb-4 flex items-center gap-1.5 text-[12.5px]" aria-label="Breadcrumb">
          <a href="/" class="dt-text-3 transition-colors hover:text-(--accent-text)">
            All tools
          </a>
          <span class="dt-text-3" aria-hidden="true">/</span>
          <span class="dt-text-2">{toolName}</span>
        </nav>
        <div class="flex items-start gap-4">
          <span class="dt-icon-tile dt-icon-tile-lg mt-1" aria-hidden="true" set:html={icon(toolIcon, 24)}></span>
          <div class="min-w-0">
            <h1 class="text-2xl font-bold tracking-tight sm:text-[28px]">{title}</h1>
            <p class="mt-1.5 max-w-3xl text-[14.5px] leading-relaxed dt-text-2">{description}</p>
          </div>
        </div>
      </div>

      <!-- Tool Content -->
      <slot />
    </main>

    <Footer />
  </div>
</BaseLayout>
